<?xml version="1.0" encoding="utf-8"?>
<Mod id="tower-national-park" version="1" xmlns="ModInfo">
	<Properties>
		<Name>LOC_MOD_NATIONAL_PARK_NAME</Name>
		<Description>LOC_MOD_NATIONAL_PARK_DESCRIPTION</Description>
		<Authors>Tower</Authors>
		<Package>NationalPark</Package>
		<PackageSortIndex>1000</PackageSortIndex>
		<ShowInBrowser>1</ShowInBrowser>
		<Version>1.2.0</Version>
	</Properties>
	<Dependencies>
		<Mod id="base-standard" title="LOC_MODULE_BASE_STANDARD_NAME"/>
	</Dependencies>
	<ActionCriteria>
		<Criteria id="always">
			<AlwaysMet></AlwaysMet>
		</Criteria>
		<!-- Parks exist from the Exploration Age on. Each age gets the shared data plus its own Constructibles, project
		     and civic unlock rows (a civic node exists only in its age's database). -->
		<Criteria id="exploration-age-current">
			<AgeInUse>AGE_EXPLORATION</AgeInUse>
		</Criteria>
		<Criteria id="modern-age-current">
			<AgeInUse>AGE_MODERN</AgeInUse>
		</Criteria>
		<!-- Civilopedia History Corrections: the history text on six independent-power pages from Civilopedia
		     Expanded: Independents. Each group needs that mod in use, so without it the game's pages are left as
		     they are. The text in history-corrections/ is a copy kept in step with the standalone mod. -->
		<Criteria id="history-corrections-antiquity">
			<ModInUse>maple-leaves-civilopedia-expanded</ModInUse>
			<AgeInUse>AGE_ANTIQUITY</AgeInUse>
		</Criteria>
		<Criteria id="history-corrections-exploration">
			<ModInUse>maple-leaves-civilopedia-expanded</ModInUse>
			<AgeInUse>AGE_EXPLORATION</AgeInUse>
		</Criteria>
		<Criteria id="history-corrections-exploration-sengoku">
			<ModInUse>maple-leaves-civilopedia-expanded</ModInUse>
			<AgeInUse>AGE_EXPLORATION</AgeInUse>
			<ModInUse>sengoku</ModInUse>
		</Criteria>
		<Criteria id="history-corrections-exploration-mlcs">
			<ModInUse>maple-leaves-civilopedia-expanded</ModInUse>
			<AgeInUse>AGE_EXPLORATION</AgeInUse>
			<ModInUse>ml-city-states-expanded</ModInUse>
		</Criteria>
	</ActionCriteria>
	<ActionGroups>
		<!-- Shell scope: text for the Additional Content browser, which runs before any game is loaded. -->
		<ActionGroup id="national-park-shell" scope="shell" criteria="always">
			<Actions>
				<UpdateText>
					<Item>text/en_us/ModuleText.xml</Item>
					<Item locale="de_DE">text/de_de/ModuleText.xml</Item>
					<Item locale="es_ES">text/es_es/ModuleText.xml</Item>
					<Item locale="fr_FR">text/fr_fr/ModuleText.xml</Item>
					<Item locale="it_IT">text/it_it/ModuleText.xml</Item>
					<Item locale="ja_JP">text/ja_jp/ModuleText.xml</Item>
					<Item locale="ko_KR">text/ko_kr/ModuleText.xml</Item>
					<Item locale="pl_PL">text/pl_pl/ModuleText.xml</Item>
					<Item locale="pt_BR">text/pt_br/ModuleText.xml</Item>
					<Item locale="ru_RU">text/ru_ru/ModuleText.xml</Item>
					<Item locale="zh_Hans_CN">text/zh_cn/ModuleText.xml</Item>
					<Item locale="zh_Hant_HK">text/zh_hk/ModuleText.xml</Item>
				</UpdateText>
				<!-- The Options entry, so it can be set from the main menu too. -->
				<UIScripts>
					<!-- Tower Settings Keeper: listed first, imports nothing, so it runs before anything reads storage. -->
					<Item>ui/settings-keeper.js</Item>
					<Item>ui/np-options.js</Item>
				</UIScripts>
				<ImportFiles>
					<Item>ui/np-options.js</Item>
					<Item>ui/np-settings.js</Item>
				</ImportFiles>
			</Actions>
		</ActionGroup>
		<ActionGroup id="national-park-exploration" scope="game" criteria="exploration-age-current">
			<Actions>
				<UpdateText>
					<Item>text/en_us/ModuleText.xml</Item>
					<Item>text/en_us/PediaText.xml</Item>
					<Item locale="de_DE">text/de_de/ModuleText.xml</Item>
					<Item locale="de_DE">text/de_de/PediaText.xml</Item>
					<Item locale="es_ES">text/es_es/ModuleText.xml</Item>
					<Item locale="es_ES">text/es_es/PediaText.xml</Item>
					<Item locale="fr_FR">text/fr_fr/ModuleText.xml</Item>
					<Item locale="fr_FR">text/fr_fr/PediaText.xml</Item>
					<Item locale="it_IT">text/it_it/ModuleText.xml</Item>
					<Item locale="it_IT">text/it_it/PediaText.xml</Item>
					<Item locale="ja_JP">text/ja_jp/ModuleText.xml</Item>
					<Item locale="ja_JP">text/ja_jp/PediaText.xml</Item>
					<Item locale="ko_KR">text/ko_kr/ModuleText.xml</Item>
					<Item locale="ko_KR">text/ko_kr/PediaText.xml</Item>
					<Item locale="pl_PL">text/pl_pl/ModuleText.xml</Item>
					<Item locale="pl_PL">text/pl_pl/PediaText.xml</Item>
					<Item locale="pt_BR">text/pt_br/ModuleText.xml</Item>
					<Item locale="pt_BR">text/pt_br/PediaText.xml</Item>
					<Item locale="ru_RU">text/ru_ru/ModuleText.xml</Item>
					<Item locale="ru_RU">text/ru_ru/PediaText.xml</Item>
					<Item locale="zh_Hans_CN">text/zh_cn/ModuleText.xml</Item>
					<Item locale="zh_Hant_HK">text/zh_hk/ModuleText.xml</Item>
					<Item locale="zh_Hans_CN">text/zh_cn/PediaText.xml</Item>
					<Item locale="zh_Hant_HK">text/zh_hk/PediaText.xml</Item>
				</UpdateText>
				<UpdateDatabase>
					<Item>data/national-parks-exploration.xml</Item>
					<Item>data/national-parks.xml</Item>
					<Item>data/national-parks-land.xml</Item>
					<Item>data/national-parks-gameeffects.xml</Item>
					<Item>data/national-parks-resources.sql</Item>
					<Item>data/national-parks-project.xml</Item>
					<Item>data/np-civilopedia.xml</Item>
				</UpdateDatabase>
				<UpdateIcons>
					<Item>data/national-parks-icons.xml</Item>
				</UpdateIcons>
				<UIScripts>
					<!-- Tower Settings Keeper: listed first, imports nothing, so it runs before anything reads storage. -->
					<Item>ui/settings-keeper.js</Item>
					<Item>ui/np-main.js</Item>
					<Item>ui/np-options.js</Item>
				</UIScripts>
				<ImportFiles>
					<Item>ui/np-main.js</Item>
					<Item>ui/np-main-state.js</Item>
					<Item>ui/np-main-founding.js</Item>
					<Item>ui/np-main-ai.js</Item>
					<Item>ui/np-main-guard.js</Item>
					<Item>ui/np-core.js</Item>
					<Item>ui/np-core-base.js</Item>
					<Item>ui/np-core-map.js</Item>
					<Item>ui/np-core-registry.js</Item>
					<Item>ui/np-core-writes.js</Item>
					<Item>ui/np-core-rules.js</Item>
					<Item>ui/np-core-sweep.js</Item>
					<Item>ui/np-draw.js</Item>
					<Item>ui/np-picker.js</Item>
					<Item>ui/np-picker-kit.js</Item>
					<Item>ui/np-picker-rename.js</Item>
					<Item>ui/np-picker-notices.js</Item>
					<Item>ui/np-picker-prompt.js</Item>
					<Item>ui/np-dialog.js</Item>
					<Item>ui/np-quotes.js</Item>
					<Item>ui/np-purchase.js</Item>
					<Item>ui/np-names.js</Item>
					<Item>ui/np-wildlife.js</Item>
					<Item>ui/np-plan.js</Item>
					<Item>ui/np-plan-kit.js</Item>
					<Item>ui/np-plan-routes.js</Item>
					<Item>ui/np-plan-built.js</Item>
					<Item>ui/np-plan-corridors.js</Item>
					<Item>ui/np-plan-vegetation.js</Item>
					<Item>ui/np-plan-wildlife.js</Item>
					<Item>ui/np-lens.js</Item>
					<Item>ui/np-settings.js</Item>
					<Item>ui/np-options.js</Item>
				</ImportFiles>
			</Actions>
			<Properties>
				<LoadOrder>9999</LoadOrder>
			</Properties>
		</ActionGroup>
		<ActionGroup id="national-park-modern" scope="game" criteria="modern-age-current">
			<Actions>
				<UpdateText>
					<Item>text/en_us/ModuleText.xml</Item>
					<Item>text/en_us/PediaText.xml</Item>
					<Item locale="de_DE">text/de_de/ModuleText.xml</Item>
					<Item locale="de_DE">text/de_de/PediaText.xml</Item>
					<Item locale="es_ES">text/es_es/ModuleText.xml</Item>
					<Item locale="es_ES">text/es_es/PediaText.xml</Item>
					<Item locale="fr_FR">text/fr_fr/ModuleText.xml</Item>
					<Item locale="fr_FR">text/fr_fr/PediaText.xml</Item>
					<Item locale="it_IT">text/it_it/ModuleText.xml</Item>
					<Item locale="it_IT">text/it_it/PediaText.xml</Item>
					<Item locale="ja_JP">text/ja_jp/ModuleText.xml</Item>
					<Item locale="ja_JP">text/ja_jp/PediaText.xml</Item>
					<Item locale="ko_KR">text/ko_kr/ModuleText.xml</Item>
					<Item locale="ko_KR">text/ko_kr/PediaText.xml</Item>
					<Item locale="pl_PL">text/pl_pl/ModuleText.xml</Item>
					<Item locale="pl_PL">text/pl_pl/PediaText.xml</Item>
					<Item locale="pt_BR">text/pt_br/ModuleText.xml</Item>
					<Item locale="pt_BR">text/pt_br/PediaText.xml</Item>
					<Item locale="ru_RU">text/ru_ru/ModuleText.xml</Item>
					<Item locale="ru_RU">text/ru_ru/PediaText.xml</Item>
					<Item locale="zh_Hans_CN">text/zh_cn/ModuleText.xml</Item>
					<Item locale="zh_Hant_HK">text/zh_hk/ModuleText.xml</Item>
					<Item locale="zh_Hans_CN">text/zh_cn/PediaText.xml</Item>
					<Item locale="zh_Hant_HK">text/zh_hk/PediaText.xml</Item>
				</UpdateText>
				<UpdateDatabase>
					<Item>data/national-parks-modern.xml</Item>
					<Item>data/national-parks.xml</Item>
					<Item>data/national-parks-land.xml</Item>
					<Item>data/national-parks-gameeffects.xml</Item>
					<Item>data/national-parks-resources.sql</Item>
					<Item>data/national-parks-project.xml</Item>
					<Item>data/np-civilopedia.xml</Item>
				</UpdateDatabase>
				<UpdateIcons>
					<Item>data/national-parks-icons.xml</Item>
				</UpdateIcons>
				<UIScripts>
					<!-- Tower Settings Keeper: listed first, imports nothing, so it runs before anything reads storage. -->
					<Item>ui/settings-keeper.js</Item>
					<Item>ui/np-main.js</Item>
					<Item>ui/np-options.js</Item>
				</UIScripts>
				<ImportFiles>
					<Item>ui/np-main.js</Item>
					<Item>ui/np-main-state.js</Item>
					<Item>ui/np-main-founding.js</Item>
					<Item>ui/np-main-ai.js</Item>
					<Item>ui/np-main-guard.js</Item>
					<Item>ui/np-core.js</Item>
					<Item>ui/np-core-base.js</Item>
					<Item>ui/np-core-map.js</Item>
					<Item>ui/np-core-registry.js</Item>
					<Item>ui/np-core-writes.js</Item>
					<Item>ui/np-core-rules.js</Item>
					<Item>ui/np-core-sweep.js</Item>
					<Item>ui/np-draw.js</Item>
					<Item>ui/np-picker.js</Item>
					<Item>ui/np-picker-kit.js</Item>
					<Item>ui/np-picker-rename.js</Item>
					<Item>ui/np-picker-notices.js</Item>
					<Item>ui/np-picker-prompt.js</Item>
					<Item>ui/np-dialog.js</Item>
					<Item>ui/np-quotes.js</Item>
					<Item>ui/np-purchase.js</Item>
					<Item>ui/np-names.js</Item>
					<Item>ui/np-wildlife.js</Item>
					<Item>ui/np-plan.js</Item>
					<Item>ui/np-plan-kit.js</Item>
					<Item>ui/np-plan-routes.js</Item>
					<Item>ui/np-plan-built.js</Item>
					<Item>ui/np-plan-corridors.js</Item>
					<Item>ui/np-plan-vegetation.js</Item>
					<Item>ui/np-plan-wildlife.js</Item>
					<Item>ui/np-lens.js</Item>
					<Item>ui/np-settings.js</Item>
					<Item>ui/np-options.js</Item>
				</ImportFiles>
			</Actions>
			<Properties>
				<LoadOrder>9999</LoadOrder>
			</Properties>
		</ActionGroup>
		<!-- Civilopedia History Corrections, loaded at 1000 to come after Civilopedia Expanded's groups (10, 100
		     and 210). Text only. -->
		<ActionGroup id="history-corrections-antiquity-text" scope="game" criteria="history-corrections-antiquity">
			<Properties>
				<LoadOrder>1000</LoadOrder>
			</Properties>
			<Actions>
				<UpdateText>
					<Item>history-corrections/antiquity-text.xml</Item>
				</UpdateText>
			</Actions>
		</ActionGroup>
		<ActionGroup id="history-corrections-exploration-text" scope="game" criteria="history-corrections-exploration">
			<Properties>
				<LoadOrder>1000</LoadOrder>
			</Properties>
			<Actions>
				<UpdateText>
					<Item>history-corrections/exploration-text.xml</Item>
				</UpdateText>
			</Actions>
		</ActionGroup>
		<ActionGroup id="history-corrections-exploration-sengoku-text" scope="game" criteria="history-corrections-exploration-sengoku">
			<Properties>
				<LoadOrder>1000</LoadOrder>
			</Properties>
			<Actions>
				<UpdateText>
					<Item>history-corrections/exploration-sengoku-text.xml</Item>
				</UpdateText>
			</Actions>
		</ActionGroup>
		<ActionGroup id="history-corrections-exploration-mlcs-text" scope="game" criteria="history-corrections-exploration-mlcs">
			<Properties>
				<LoadOrder>1000</LoadOrder>
			</Properties>
			<Actions>
				<UpdateText>
					<Item>history-corrections/exploration-mlcs-text.xml</Item>
				</UpdateText>
			</Actions>
		</ActionGroup>
	</ActionGroups>
	<LocalizedText>
		<File>text/en_us/ModuleText.xml</File>
		<File>text/en_us/PediaText.xml</File>
	</LocalizedText>
</Mod>

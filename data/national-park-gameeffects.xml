<?xml version="1.0" encoding="utf-8"?>
<!--
  MOD_NP_NO_NATURAL_YIELD: kept only so saves from pre-release builds load clean. In pre-release builds every land marker carried
  it as a -100% yield on its plot, and a saved game keeps that modifier on the plot even after the marker is gone
  (watched 2026-10-01: a pre-release park tile read 0 Food and Production with the marker replaced and no such modifier in
  the database). Defined again here as 0%, so the saved copies take nothing; no marker carries it any more.
-->
<GameEffects xmlns="GameEffects">
    <Modifier id="MOD_NP_NO_NATURAL_YIELD" collection="COLLECTION_SINGLE_PLOT_YIELDS" effect="EFFECT_PLOT_ADJUST_YIELD">
        <Argument name="YieldType">YIELD_FOOD</Argument>
        <Argument name="Percent">0</Argument>
    </Modifier>
</GameEffects>

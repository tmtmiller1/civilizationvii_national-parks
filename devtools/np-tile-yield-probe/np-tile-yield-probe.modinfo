<?xml version="1.0" encoding="utf-8"?>
<!-- DEV ONLY. Can a park marker's payout show on its own tile, and survive MOD_NP_NO_NATURAL_YIELD (-100%)?
     Route A: Constructible_YieldChanges on IMPROVEMENT_NATIONAL_PARK_LAND (+1 Culture, +1 Happiness).
     Route B: an EFFECT_PLOT_ADJUST_YIELD Amount modifier on IMPROVEMENT_NATIONAL_PARK_WILD's own plot (+2 Culture).
     Read GameplayMap.getYield on a marked tile of each kind, the yields layer, and the city's totals. Remove from Mods/ after. -->
<Mod id="tower-national-park-tile-yield-probe" version="1" xmlns="ModInfo">
	<Properties>
		<Name>National Park tile yield probe (dev)</Name>
		<Description>Dev only: park payouts as tile yields.</Description>
		<Authors>Tower</Authors>
		<Package>NationalPark</Package>
		<ShowInBrowser>1</ShowInBrowser>
		<AffectsSavedGames>1</AffectsSavedGames>
	</Properties>
	<Dependencies>
		<Mod id="tower-national-park" title="National Park"/>
	</Dependencies>
	<ActionCriteria>
		<Criteria id="always"><AlwaysMet></AlwaysMet></Criteria>
	</ActionCriteria>
	<ActionGroups>
		<ActionGroup id="np-tile-yield-probe-data" scope="game" criteria="always">
			<Actions>
				<UpdateDatabase>
					<Item>data/probe-effects.xml</Item>
					<Item>data/probe.xml</Item>
				</UpdateDatabase>
			</Actions>
			<Properties><LoadOrder>10004</LoadOrder></Properties>
		</ActionGroup>
	</ActionGroups>
</Mod>
